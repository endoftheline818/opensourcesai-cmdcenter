{
  "name": "@opensourcesai/cmdcenter",
  "version": "0.1.2",
  "description": "Local command center for a machine running Ollama — real hardware detection, model fit, live system pressure, honest measurement, and bench-result inspection. Talks only to AI runtimes on this machine, never to the internet.",
  "type": "module",
  "bin": {
    "osai-cmdcenter": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "data",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/cli.js && node --test",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endoftheline818/opensourcesai-cmdcenter.git"
  },
  "license": "MIT",
  "keywords": [
    "ollama",
    "local-llm",
    "diagnostics",
    "hardware-detection"
  ]
}
